Options -MultiViews
RewriteEngine On

# Keep one canonical hostname.
RewriteCond %{HTTP_HOST} ^www\.temelcidentist\.com$ [NC]
RewriteRule ^ https://temelcidentist.com%{REQUEST_URI} [R=301,L]

# Canonical English landing page.
RewriteRule ^$ /en [R=301,L]
RewriteRule ^index\.html$ /en [R=301,L]
RewriteRule ^landing/?$ /en [R=301,L]

# Serve generated assets as-is.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Remove a trailing slash when a generated clean-URL HTML file exists.
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Serve generated clean-URL HTML entry points when present.
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Serve real asset directories as-is.
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# React Router fallback.
RewriteRule ^ /index.html [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(?:js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:png|jpe?g|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(?:html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
